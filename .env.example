NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://horizon:horizonpassword@localhost:5432/horizon_db?schema=public"

# Docker/PostgreSQL
POSTGRES_USER=horizon
POSTGRES_PASSWORD=horizonpassword
POSTGRES_DB=horizon_db
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
SEED_DEMO_DATA=false
SYNC_ADMIN_PASSWORD_ON_SEED=true

# SMTP email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@academie-horizon.test
SMTP_PASS=replace_with_google_app_password_without_spaces
MAIL_FROM="Académie Horizon — Service Inscriptions <contact@academie-horizon.test>"

# Admin authentication
ADMIN_EMAIL=contact@academie-horizon.test
ADMIN_PASSWORD=1234
